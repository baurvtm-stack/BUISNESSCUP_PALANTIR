# Server-only. Leave database settings blank for the bundled JSON catalog.
SUPABASE_URL=
# Preferred Supabase secret API key (sb_secret_...). Never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service-role JWT alternative; ignored when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=

# Optional affiliate identifier; blank leaves the retailer URL untagged.
AFFILIATE_TAG=
# Query parameter required by your affiliate partner (Amazon uses tag).
AFFILIATE_PARAM=tag

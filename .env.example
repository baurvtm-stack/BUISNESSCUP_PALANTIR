# Server-only. Leave database settings blank for the bundled JSON catalog.
SUPABASE_URL=
# Preferred Supabase secret API key (sb_secret_...). Never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy service-role JWT alternative; ignored when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Amazon partner tag, added to Amazon fallback links only; maker pages are never tagged.
AFFILIATE_TAG=
# Query parameter required by your affiliate partner (Amazon uses tag).
AFFILIATE_PARAM=tag

# Canonical origin. For local development use http://localhost:3000.
# Blank on Vercel falls back to https://${VERCEL_PROJECT_PRODUCTION_URL}.
APP_URL=
# VERCEL_PROJECT_PRODUCTION_URL and VERCEL are supplied by Vercel; do not override.
# Recommended random 32+ byte secret; blank uses an unsalted SHA-256 rate-limit key.
RATE_LIMIT_SECRET=
# Required independent random 32+ byte bearer secret for cron and demo sends.
CRON_SECRET=
RESEND_API_KEY=
# Must be a verified sender, or Resend onboarding sender for your own test inbox.
RESEND_FROM=GearFit <reminders@example.com>
REMINDER_TEST_MODE=false
# TEST keys only. Price is fixed server-side at USD 400 cents / month.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public frontend flag only. Keep 0/unset in production; 1 is for local mocks.
NEXT_PUBLIC_API_MOCKS=0
# Optional public canonical site URL for frontend metadata/share previews.
NEXT_PUBLIC_SITE_URL=
# VERCEL_URL is also injected by Vercel for the frontend metadata fallback.

# Test runner only (set in your shell/CI, not Vercel's application environment).
# Blank: npm run e2e starts an isolated local production app at http://localhost:3000.
# Set a URL to test an already running app, with Supabase configured for saves/stats.
PLAYWRIGHT_BASE_URL=
# Optional GitHub Actions secret for protected Vercel previews; never NEXT_PUBLIC_.
VERCEL_AUTOMATION_BYPASS_SECRET=
